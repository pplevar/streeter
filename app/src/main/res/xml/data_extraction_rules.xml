<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="streeter_database" />
        <!-- Sync auth bearer token is device-local; never upload it (issue #17, ADR-0002) -->
        <exclude domain="sharedpref" path="streeter_sync_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="streeter_database" />
    </device-transfer>
</data-extraction-rules>
